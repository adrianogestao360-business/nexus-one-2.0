generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id           Int      @id @default(autoincrement())
  razaoSocial  String
  nomeFantasia String
  cnpj         String   @unique
  email        String?
  telefone     String?
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inscricaoEstadual       String?
  inscricaoEstadualIsento Boolean @default(false)
  regimeTributario        String?
  logradouro              String?
  numero                  String?
  complemento             String?
  bairro                  String?
  municipio               String?
  codigoMunicipioIBGE     String?
  uf                      String?
  cep                     String?

  integracaoFiscal IntegracaoFiscal?

  usuarios      Usuario[]
  papeis        Papel[]
  refreshTokens RefreshToken[]
  produtos      Produto[]
  clientes      Cliente[]
  fornecedores  Fornecedor[]
  vendas        Venda[]
  compras       Compra[]
  titulos       Titulo[]
  movimentos    MovimentoEstoque[]
  zonas         Zona[]
  separacoes    Separacao[]
  veiculos      Veiculo[]
  motoristas    Motorista[]
  entregas      Entrega[]
  notasFiscais  NotaFiscal[]
  localizacoes  Localizacao[]
  estoquesLocalizacao EstoqueLocalizacao[]
  oportunidades Oportunidade[]
  logsAuditoria LogAuditoria[]
  rotas         Rota[]
  abastecimentos Abastecimento[]
  cargos        Cargo[]
  funcionarios  Funcionario[]
  folhasPagamento FolhaPagamento[]
  notificacoesLidas NotificacaoLida[]
  metasVenda    MetaVenda[]
  devolucoes    Devolucao[]
  contasBancarias ContaBancaria[]
  lotes         Lote[]
  inventarios   Inventario[]
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  ativo     Boolean  @default(true)
  empresaId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa            Empresa             @relation(fields: [empresaId], references: [id])
  usuarioPapeis      UsuarioPapel[]
  refreshTokens      RefreshToken[]
  separacoes         Separacao[]
  logsAuditoria      LogAuditoria[]
  notificacoesLidas  NotificacaoLida[]
  vendasComoVendedor Venda[]
  metasVenda         MetaVenda[]
  inventarios        Inventario[]

  @@index([empresaId])
}

model LogAuditoria {
  id          Int      @id @default(autoincrement())
  empresaId   Int?
  usuarioId   Int?
  acao        String
  entidade    String
  entidadeId  Int?
  detalhes    Json?
  ip          String?
  createdAt   DateTime @default(now())

  empresa Empresa? @relation(fields: [empresaId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([empresaId])
  @@index([acao])
}

model Papel {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  empresaId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa         Empresa          @relation(fields: [empresaId], references: [id])
  usuarioPapeis   UsuarioPapel[]
  papelPermissoes PapelPermissao[]

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model Permissao {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  descricao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  papelPermissoes PapelPermissao[]
}

model UsuarioPapel {
  usuarioId Int
  papelId   Int

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  papel   Papel   @relation(fields: [papelId], references: [id], onDelete: Cascade)

  @@id([usuarioId, papelId])
}

model PapelPermissao {
  papelId     Int
  permissaoId Int

  papel     Papel     @relation(fields: [papelId], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@id([papelId, permissaoId])
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  usuarioId Int
  empresaId Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([empresaId])
}

model Produto {
  id        Int      @id @default(autoincrement())
  codigo    String
  descricao String
  categoria String?
  unidade   String?
  preco     Decimal  @default(0) @db.Decimal(12, 2)
  estoque   Int      @default(0)
  estoqueMinimo Int  @default(5)
  ativo     Boolean  @default(true)
  empresaId Int
  zonaId    Int?
  endereco  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ncm    String?
  cfop   String?
  origem Int?    @default(0)
  cest   String?

  controlaLote Boolean @default(false)

  empresa Empresa @relation(fields: [empresaId], references: [id])
  zona    Zona?   @relation(fields: [zonaId], references: [id])
  vendaItens VendaItem[]
  compraItens CompraItem[]
  movimentos MovimentoEstoque[]
  separacaoItens SeparacaoItem[]
  estoquesLocalizacao EstoqueLocalizacao[]
  devolucaoItens DevolucaoItem[]
  lotes Lote[]
  inventarios Inventario[]
  inventarioItens InventarioItem[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String
  documento String?
  email     String?
  telefone  String?
  ativo     Boolean  @default(true)
  empresaId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tipoDocumento       String?
  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  municipio           String?
  codigoMunicipioIBGE String?
  uf                  String?
  cep                 String?

  limiteCredito Decimal? @db.Decimal(12, 2)

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  vendas        Venda[]
  titulos       Titulo[]
  oportunidades Oportunidade[]

  @@index([empresaId])
}

model Oportunidade {
  id          Int      @id @default(autoincrement())
  titulo      String
  clienteId   Int
  empresaId   Int
  valor       Decimal  @default(0) @db.Decimal(12, 2)
  estagio     String   @default("novo")
  observacoes String?
  motivoPerda String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([empresaId])
}

model Fornecedor {
  id        Int      @id @default(autoincrement())
  nome      String
  documento String?
  email     String?
  telefone  String?
  ativo     Boolean  @default(true)
  empresaId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  compras Compra[]
  titulos Titulo[]

  @@index([empresaId])
}

model Venda {
  id         Int      @id @default(autoincrement())
  clienteId  Int
  empresaId  Int
  vendedorId Int?
  total      Decimal  @default(0) @db.Decimal(12, 2)
  status     String   @default("confirmada")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  cliente  Cliente  @relation(fields: [clienteId], references: [id])
  vendedor Usuario? @relation(fields: [vendedorId], references: [id])
  itens    VendaItem[]
  titulos Titulo[]
  movimentos MovimentoEstoque[]
  separacao  Separacao?
  notasFiscais NotaFiscal[]
  devolucoes Devolucao[]

  @@index([empresaId])
}

model VendaItem {
  id            Int     @id @default(autoincrement())
  vendaId       Int
  produtoId     Int
  quantidade    Int
  precoUnitario Decimal @db.Decimal(12, 2)
  subtotal      Decimal @db.Decimal(12, 2)

  venda   Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([vendaId])
}

model Compra {
  id           Int      @id @default(autoincrement())
  fornecedorId Int
  empresaId    Int
  total        Decimal  @default(0) @db.Decimal(12, 2)
  status       String   @default("confirmada")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresa    Empresa      @relation(fields: [empresaId], references: [id])
  fornecedor Fornecedor   @relation(fields: [fornecedorId], references: [id])
  itens      CompraItem[]
  titulos    Titulo[]
  movimentos MovimentoEstoque[]
  notasFiscais NotaFiscal[]
  devolucoes Devolucao[]

  @@index([empresaId])
}

model CompraItem {
  id            Int     @id @default(autoincrement())
  compraId      Int
  produtoId     Int
  quantidade    Int
  precoUnitario Decimal @db.Decimal(12, 2)
  subtotal      Decimal @db.Decimal(12, 2)

  compra  Compra  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@index([compraId])
}

model Titulo {
  id            Int       @id @default(autoincrement())
  tipo          String
  descricao     String
  valor         Decimal   @db.Decimal(12, 2)
  vencimento    DateTime
  status        String    @default("aberta")
  dataPagamento DateTime?
  empresaId     Int
  clienteId     Int?
  fornecedorId  Int?
  vendaId       Int?
  compraId      Int?
  parcela       Int?
  totalParcelas Int?
  folhaPagamentoItemId Int?
  contaBancariaId Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  empresa            Empresa             @relation(fields: [empresaId], references: [id])
  cliente            Cliente?            @relation(fields: [clienteId], references: [id])
  fornecedor         Fornecedor?         @relation(fields: [fornecedorId], references: [id])
  venda              Venda?              @relation(fields: [vendaId], references: [id])
  compra             Compra?             @relation(fields: [compraId], references: [id])
  folhaPagamentoItem FolhaPagamentoItem? @relation(fields: [folhaPagamentoItemId], references: [id])
  contaBancaria      ContaBancaria?      @relation(fields: [contaBancariaId], references: [id])

  @@index([empresaId])
}

model MovimentoEstoque {
  id            Int      @id @default(autoincrement())
  produtoId     Int
  empresaId     Int
  tipo          String
  quantidade    Int
  motivo        String
  origem        String
  saldoApos     Int
  vendaId       Int?
  compraId      Int?
  localizacaoId Int?
  loteId        Int?
  createdAt     DateTime @default(now())

  produto     Produto      @relation(fields: [produtoId], references: [id])
  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  venda       Venda?       @relation(fields: [vendaId], references: [id])
  compra      Compra?      @relation(fields: [compraId], references: [id])
  localizacao Localizacao? @relation(fields: [localizacaoId], references: [id])
  lote        Lote?        @relation(fields: [loteId], references: [id])

  @@index([empresaId])
  @@index([produtoId])
}

model Inventario {
  id            Int       @id @default(autoincrement())
  tipo          String    @default("geral")
  status        String    @default("aberto")
  empresaId     Int
  localizacaoId Int?
  produtoId     Int?
  observacao    String?
  criadoPorId   Int?
  fechadoEm     DateTime?
  createdAt     DateTime  @default(now())

  empresa     Empresa          @relation(fields: [empresaId], references: [id])
  localizacao Localizacao?     @relation(fields: [localizacaoId], references: [id])
  produto     Produto?         @relation(fields: [produtoId], references: [id])
  criadoPor   Usuario?         @relation(fields: [criadoPorId], references: [id])
  itens       InventarioItem[]

  @@index([empresaId])
}

model InventarioItem {
  id                Int       @id @default(autoincrement())
  inventarioId      Int
  produtoId         Int
  localizacaoId     Int
  quantidadeSistema Int
  quantidadeContada Int?
  contadoEm         DateTime?

  inventario  Inventario  @relation(fields: [inventarioId], references: [id])
  produto     Produto     @relation(fields: [produtoId], references: [id])
  localizacao Localizacao @relation(fields: [localizacaoId], references: [id])

  @@unique([inventarioId, produtoId, localizacaoId])
  @@index([inventarioId])
}

model Lote {
  id           Int       @id @default(autoincrement())
  produtoId    Int
  numero       String
  dataValidade DateTime?
  quantidade   Int       @default(0)
  ativo        Boolean   @default(true)
  empresaId    Int
  createdAt    DateTime  @default(now())

  produto    Produto            @relation(fields: [produtoId], references: [id])
  empresa    Empresa            @relation(fields: [empresaId], references: [id])
  movimentos MovimentoEstoque[]

  @@unique([produtoId, numero])
  @@index([empresaId])
}

model Zona {
  id        Int      @id @default(autoincrement())
  nome      String
  empresaId Int
  createdAt DateTime @default(now())

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  produtos     Produto[]
  localizacoes Localizacao[]

  @@unique([empresaId, nome])
}

model Localizacao {
  id        Int      @id @default(autoincrement())
  codigo    String
  zonaId    Int?
  ativo     Boolean  @default(true)
  empresaId Int
  createdAt DateTime @default(now())

  empresa    Empresa              @relation(fields: [empresaId], references: [id])
  zona       Zona?                @relation(fields: [zonaId], references: [id])
  estoques   EstoqueLocalizacao[]
  movimentos MovimentoEstoque[]
  inventarios     Inventario[]
  inventarioItens InventarioItem[]

  @@unique([empresaId, codigo])
}

model EstoqueLocalizacao {
  id            Int @id @default(autoincrement())
  produtoId     Int
  localizacaoId Int
  empresaId     Int
  quantidade    Int @default(0)

  produto     Produto     @relation(fields: [produtoId], references: [id])
  localizacao Localizacao @relation(fields: [localizacaoId], references: [id])
  empresa     Empresa     @relation(fields: [empresaId], references: [id])

  @@unique([produtoId, localizacaoId])
}

model Separacao {
  id          Int       @id @default(autoincrement())
  vendaId     Int       @unique
  empresaId   Int
  status      String    @default("pendente")
  separadorId Int?
  iniciadoEm  DateTime?
  concluidoEm DateTime?
  expedidoEm  DateTime?
  createdAt   DateTime  @default(now())

  empresa   Empresa         @relation(fields: [empresaId], references: [id])
  venda     Venda           @relation(fields: [vendaId], references: [id])
  separador Usuario?        @relation(fields: [separadorId], references: [id])
  itens     SeparacaoItem[]
  entrega   Entrega?

  @@index([empresaId])
}

model SeparacaoItem {
  id          Int     @id @default(autoincrement())
  separacaoId Int
  produtoId   Int
  quantidade  Int
  separado    Boolean @default(false)

  separacao Separacao @relation(fields: [separacaoId], references: [id], onDelete: Cascade)
  produto   Produto   @relation(fields: [produtoId], references: [id])

  @@index([separacaoId])
}

model Veiculo {
  id             Int      @id @default(autoincrement())
  placa          String
  modelo         String
  capacidade     String?
  kmMedioPorLitro Decimal? @db.Decimal(6, 2)
  status         String   @default("disponivel")
  ativo          Boolean  @default(true)
  empresaId      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  empresa        Empresa         @relation(fields: [empresaId], references: [id])
  entregas       Entrega[]
  rotas          Rota[]
  abastecimentos Abastecimento[]

  @@unique([empresaId, placa])
  @@index([empresaId])
}

model Motorista {
  id        Int      @id @default(autoincrement())
  nome      String
  cnh       String?
  telefone  String?
  ativo     Boolean  @default(true)
  empresaId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa  Empresa   @relation(fields: [empresaId], references: [id])
  entregas Entrega[]
  rotas    Rota[]

  @@index([empresaId])
}

model Rota {
  id              Int       @id @default(autoincrement())
  empresaId       Int
  veiculoId       Int
  motoristaId     Int
  status          String    @default("em_andamento")
  tokenRastreio   String    @unique
  kmPercorrido    Decimal?  @db.Decimal(10, 2)
  custoEstimado   Decimal?  @db.Decimal(10, 2)
  ultimaLatitude  Float?
  ultimaLongitude Float?
  ultimaPosicaoEm DateTime?
  iniciadaEm      DateTime  @default(now())
  concluidaEm     DateTime?

  empresa   Empresa            @relation(fields: [empresaId], references: [id])
  veiculo   Veiculo            @relation(fields: [veiculoId], references: [id])
  motorista Motorista          @relation(fields: [motoristaId], references: [id])
  entregas  Entrega[]
  posicoes  PosicaoMotorista[]

  @@index([empresaId])
}

model PosicaoMotorista {
  id           Int      @id @default(autoincrement())
  rotaId       Int
  latitude     Float
  longitude    Float
  registradoEm DateTime @default(now())

  rota Rota @relation(fields: [rotaId], references: [id])

  @@index([rotaId])
}

model Abastecimento {
  id         Int      @id @default(autoincrement())
  veiculoId  Int
  empresaId  Int
  valorLitro Decimal  @db.Decimal(8, 3)
  litros     Decimal? @db.Decimal(8, 2)
  createdAt  DateTime @default(now())

  veiculo Veiculo @relation(fields: [veiculoId], references: [id])
  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([veiculoId])
}

model Entrega {
  id          Int       @id @default(autoincrement())
  separacaoId Int       @unique
  veiculoId   Int
  motoristaId Int
  empresaId   Int
  rotaId      Int?
  status      String    @default("em_rota")
  dataSaida   DateTime  @default(now())
  dataEntrega DateTime?
  createdAt   DateTime  @default(now())

  separacao Separacao @relation(fields: [separacaoId], references: [id])
  veiculo   Veiculo   @relation(fields: [veiculoId], references: [id])
  motorista Motorista @relation(fields: [motoristaId], references: [id])
  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  rota      Rota?     @relation(fields: [rotaId], references: [id])

  @@index([empresaId])
}

model NotaFiscal {
  id        Int       @id @default(autoincrement())
  tipo      String
  numero    String?
  status    String    @default("pendente")
  empresaId Int
  vendaId   Int?
  compraId  Int?
  emitidaEm DateTime?
  createdAt DateTime  @default(now())

  ref                  String?   @unique
  ambiente             String?
  serie                Int       @default(1)
  chaveAcesso          String?
  protocoloAutorizacao String?
  motivoStatus         String?
  xmlUrl               String?
  danfeUrl             String?
  dataAutorizacao      DateTime?

  empresa Empresa @relation(fields: [empresaId], references: [id])
  venda   Venda?  @relation(fields: [vendaId], references: [id])
  compra  Compra? @relation(fields: [compraId], references: [id])

  @@index([empresaId])
}

model IntegracaoFiscal {
  id        Int      @id @default(autoincrement())
  empresaId Int      @unique
  provedor  String   @default("focus_nfe")
  token     String?
  ambiente  String   @default("homologacao")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
}

model Cargo {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String?
  ativo       Boolean  @default(true)
  empresaId   Int
  createdAt   DateTime @default(now())

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  funcionarios Funcionario[]

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model Funcionario {
  id            Int       @id @default(autoincrement())
  nome          String
  cargoId       Int?
  salarioBase   Decimal   @db.Decimal(12, 2)
  dataAdmissao  DateTime  @default(now())
  email         String?
  telefone      String?
  ativo         Boolean   @default(true)
  empresaId     Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  empresa           Empresa             @relation(fields: [empresaId], references: [id])
  cargo             Cargo?              @relation(fields: [cargoId], references: [id])
  itensFolha        FolhaPagamentoItem[]

  @@index([empresaId])
}

model FolhaPagamento {
  id             Int       @id @default(autoincrement())
  mes            Int
  ano            Int
  status         String    @default("aberta")
  empresaId      Int
  fechadaEm      DateTime?
  createdAt      DateTime  @default(now())

  empresa Empresa              @relation(fields: [empresaId], references: [id])
  itens   FolhaPagamentoItem[]

  @@unique([empresaId, mes, ano])
  @@index([empresaId])
}

model FolhaPagamentoItem {
  id             Int      @id @default(autoincrement())
  folhaId        Int
  funcionarioId  Int
  proventos      Decimal  @db.Decimal(12, 2)
  descontos      Decimal  @default(0) @db.Decimal(12, 2)
  valorLiquido   Decimal  @db.Decimal(12, 2)

  folha       FolhaPagamento @relation(fields: [folhaId], references: [id])
  funcionario Funcionario    @relation(fields: [funcionarioId], references: [id])
  titulos     Titulo[]

  @@unique([folhaId, funcionarioId])
}

model NotificacaoLida {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  empresaId Int
  chave     String
  lidaEm    DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([usuarioId, chave])
  @@index([empresaId])
}

model MetaVenda {
  id                 Int      @id @default(autoincrement())
  empresaId          Int
  usuarioId          Int
  mes                Int
  ano                Int
  valorMeta          Decimal  @db.Decimal(12, 2)
  percentualComissao Decimal  @db.Decimal(5, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, mes, ano])
  @@index([empresaId])
}

model Devolucao {
  id         Int      @id @default(autoincrement())
  tipo       String
  motivo     String
  empresaId  Int
  vendaId    Int?
  compraId   Int?
  valorTotal Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  empresa Empresa         @relation(fields: [empresaId], references: [id])
  venda   Venda?          @relation(fields: [vendaId], references: [id])
  compra  Compra?         @relation(fields: [compraId], references: [id])
  itens   DevolucaoItem[]

  @@index([empresaId])
}

model DevolucaoItem {
  id            Int     @id @default(autoincrement())
  devolucaoId   Int
  produtoId     Int
  quantidade    Int
  valorUnitario Decimal @db.Decimal(12, 2)
  subtotal      Decimal @db.Decimal(12, 2)

  devolucao Devolucao @relation(fields: [devolucaoId], references: [id], onDelete: Cascade)
  produto   Produto   @relation(fields: [produtoId], references: [id])

  @@index([devolucaoId])
}

model ContaBancaria {
  id           Int      @id @default(autoincrement())
  nome         String
  tipo         String   @default("banco")
  saldoInicial Decimal  @default(0) @db.Decimal(12, 2)
  ativo        Boolean  @default(true)
  empresaId    Int
  createdAt    DateTime @default(now())

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  titulos Titulo[]

  @@index([empresaId])
}
